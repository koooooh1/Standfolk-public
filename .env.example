# Copy to .env (gitignored) and fill in. `npm run dev` reads it; nothing else does.

# Google AI Studio key for the agent service. Leave empty to run with template answers only.
MODEL_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite
# MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai

# Model-call limits in the API (defaults: 40 per day, reset at midnight Pacific time; 2 at once).
AGENT_DAILY_MODEL_CALLS=40
AGENT_CONCURRENT_RUNS=2

# AGENTS_PORT=8001
